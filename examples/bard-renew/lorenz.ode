# The Lorenz equations (chaotic). New in XPPAUT 8.4 (21 Nov 2026): the full
# Lyapunov spectrum, Numerics -> stocHast -> Liapunov (keys U H L), by the QR
# method in double precision with its own adaptive integrator.
# Script: lorenz-lyapunov.xps (File -> Do script, or the Scripts menu).
# Expect about 0.9, 0 and -14.6; their sum must equal the flow's divergence,
# -(s + 1 + b) = -13.667, and the Kaplan-Yorke dimension is about 2.06.
init x=-7.5  y=-3.6  z=30
par r=28  s=10  b=2.666667
x'=s*(-x+y)
y'=r*x-y-x*z
z'=-b*z+x*y
@ dt=.025, total=40, xplot=x,yplot=z
@ xlo=-20,xhi=20,ylo=0,yhi=50
@ maxstor=20000
done
