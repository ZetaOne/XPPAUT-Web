# M3_HH.xps -- method M3 (boundary value continuation) for M3_HH.ode,
# in XPP's own AUTO.  File > Do script in XPPAUT 8.4 (or XPPAUT-Web).  Each step is explained in the .ode.
speed 0.1
msg "Step 1: the starting solution, Γ from gamma0 for k = 2 periods (time rescaled to 0..1)"
keys i g
keys f a
msg "Step 3: AUTO numerics (Ntst 200, Ds -0.01, p = v(0) from -100 to 55)"
autokeys n
ans Ntst=200|Nmax=470|NPr=100000|Ds=-0.01|Dsmin=1e-08|Dsmax=0.5|Par Min=-100|Par Max=55|Norm Max=1e6|ITNW=8
msg "Step 4: Run > Bdry Value -- the isochron to the left of gamma0"
autokeys r b
msg "Step 5: back to the start, the other way -- the isochron to the right"
set p=44.706379;v=44.706379;w=0.45973791;dl=0;w0=0.45973791
keys i g
autokeys n
ans Nmax=60|Ds=0.01
autokeys r b
msg "Step 6: one point's orbit segment, in the main window"
auto goto LP 2
keys i g
msg "Done. The AUTO window is the isochron of phase 0, w(0) against v(0). M3 works where M2 cannot: no backward integration. Its limitation (the end point must stay on the straight piece of the isochron): M3_limitation_linear_HH.ode"
