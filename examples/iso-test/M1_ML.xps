# M1_ML.xps -- runs M1_ML.ode in one go (the steps at the top of the .ode).
#   XPPAUT 8.4:  File > Do script > M1_ML.xps    (or: xppaut M1_ML.ode -script M1_ML.xps)
#   XPPAUT-Web:  the Test-Isochrons page's "Open in XPPAUT-Web" loads both files and runs it
speed 0.3
msg "M1, brute force: integrate every starting point of a grid, read its phase from its spikes"

# A. the phase map: colour each dot by its asymptotic phase theta (0..1, periodic colours)
keys u c a
ans theta
ans c
ans 0
ans 1
keys esc
msg "2par range over the starting point (px, py): 50 x 50 = 2500 runs, one dot each"
keys i 2
ans Vary1=px|Start1=-70|End1=50|Vary2=py|Start2=0|End2=0.65|Steps=50|Steps2=50|Reset storage (Y/N)=N|Use old ic's (Y/N)=Y|Cycle color (Y/N)=N|Movie(Y/N)=N|Crv(1) Array(2)=2
msg "The phase map: points with the same colour have the same phase. Colour bands = isochrons."
wait 4

# B. isochrons as dots: keep only the starting points with theta within tol of k/niso
keys u c n
keys esc
keys e
set yp=isoy
msg "Now only the points whose phase is 0, 0.1, ..., 0.9 (within tol): ten isochrons"
keys i 2
ans Vary1=px|Start1=-70|End1=50|Vary2=py|Start2=0|End2=0.65|Steps=80|Steps2=80|Reset storage (Y/N)=N|Use old ic's (Y/N)=Y|Cycle color (Y/N)=N|Movie(Y/N)=N|Crv(1) Array(2)=2
msg "Ten isochrons by brute force. They crowd into the equilibrium x*: see M1_limitation_pileup_ML."
