# M3_HH_isochrons.xps -- 20 HH isochrons by M3 in XPP's AUTO, looping over the presets in the tables
# (see M3_HH_isochrons.ode).  File > Do script in XPPAUT 8.4 or XPPAUT-Web.  About 25 minutes native.
# "autokeys esc" before main-window keys gives the keyboard focus back to the main window
# (XQuartz gives it to the AUTO window; harmless elsewhere).
speed 0.1
msg "Gamma, frozen; AUTO numerics (Ntst 600, k = 3 periods, SuppBP 1)"
keys i g
keys g f f
ans Color=0|Key=Gamma|Name=Gamma
keys f a
autokeys n
ans Ntst=600|Nmax=1500|NPr=100000|Ds=0.01|Dsmin=1e-08|Dsmax=0.5|Par Min=-100|Par Max=55|Norm Max=1e6|ITNW=20|SuppBP=1

# isochrons 2 3 4 5 6 7 8 9 11 14 15 16 17 18: Nmax 1500 (V up), 1500 (V down)
for iso in 2 3 4 5 6 7 8 9 11 14 15 16 17 18
  msg "isochron $iso of 20 (V up)"
  set iso=$iso;dl=0
  autokeys esc
  keys i u
  ans v
  ans 1
  ans p:tgv(iso)
  ans w
  ans 1
  ans tgw(iso)
  ans w0
  ans 1
  ans tgw(iso)
  ans dl
  ans 1
  ans 0
  keys esc
  keys i g
  autokeys n
  ans Nmax=1500|Ds=0.01
  autokeys r b
  msg "isochron $iso of 20 (V down)"
  set iso=$iso;dl=0
  autokeys esc
  keys i u
  ans v
  ans 1
  ans p:tgv(iso)
  ans w
  ans 1
  ans tgw(iso)
  ans w0
  ans 1
  ans tgw(iso)
  ans dl
  ans 1
  ans 0
  keys esc
  keys i g
  autokeys n
  ans Nmax=1500|Ds=-0.01
  autokeys r b
end

