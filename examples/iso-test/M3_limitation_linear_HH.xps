# M3_limitation_linear_HH.xps -- method M3 (boundary value continuation) with k = 1 for M3_limitation_linear_HH.ode,
# in XPP's own AUTO.  File > Do script in XPPAUT 8.4 (or XPPAUT-Web).  Each step is explained in the .ode.
speed 0.1
msg "Step 1: the starting solution, Gamma from gamma0 for k = 1 period (time rescaled to 0..1)"
keys i g
keys f a
msg "Step 3: AUTO numerics (Ntst 100, Ds -0.01, p = v(0) from -100 to 55)"
autokeys n
ans Ntst=100|Nmax=900|NPr=100000|Ds=-0.01|Dsmin=1e-08|Dsmax=0.5|Par Min=-100|Par Max=55|Norm Max=1e6|ITNW=8
msg "Step 4: Run > Bdry Value -- the isochron to the left of gamma0"
autokeys r b
msg "Step 5: back to the start, the other way -- the isochron to the right"
set p=44.706379;v=44.706379;w=0.45973791;dl=0;w0=0.45973791
keys i g
autokeys n
ans Nmax=60|Ds=0.01
autokeys r b
msg "Done. Past the equilibrium the end point slides off the straight piece (dl grows) and the curve runs off to (-100, 0.51): those points have phase about 0.42, not 0. Cure: longer segments, k = 3: M3_HH.ode"
