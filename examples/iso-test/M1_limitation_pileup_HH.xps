# M1_limitation_pileup_HH.xps -- runs M1_limitation_pileup_HH.ode in one go (the steps at the top of the .ode).
#   XPPAUT 8.4:  File > Do script > M1_limitation_pileup_HH.xps    (or: xppaut M1_limitation_pileup_HH.ode -script M1_limitation_pileup_HH.xps)
#   XPPAUT-Web:  the Test-Isochrons page's "Open in XPPAUT-Web" loads both files and runs it
speed 0.3
msg "M1 near the equilibrium x* = (-59.6044, 0.402577): a box 2 by 0.02, coloured by phase"
keys u c a
ans theta
ans c
ans 0
ans 1
keys esc
keys i 2
ans Vary1=px|Start1=-60.6044|End1=-58.6044|Vary2=py|Start2=0.392577|End2=0.412577|Steps=40|Steps2=40|Reset storage (Y/N)=N|Use old ic's (Y/N)=Y|Cycle color (Y/N)=N|Movie(Y/N)=N|Crv(1) Array(2)=2
msg "Every phase (every colour) appears in this small box. Now a box 10 times smaller:"
wait 4
keys e
set xlo=-59.7044;xhi=-59.5044;ylo=0.401577;yhi=0.403577
keys i 2
ans Vary1=px|Start1=-59.7044|End1=-59.5044|Vary2=py|Start2=0.401577|End2=0.403577|Steps=40|Steps2=40|Reset storage (Y/N)=N|Use old ic's (Y/N)=Y|Cycle color (Y/N)=N|Movie(Y/N)=N|Crv(1) Array(2)=2
msg "Still every phase: no grid resolves the isochrons at x*. M1 cannot draw them here."
