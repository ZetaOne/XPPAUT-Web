# Build the unmodified XPPAUT source against our own Xlib layer
# (web/xlib) instead of libX11.
#
#   make headless        native binary            -> build/headless-cc/xppaut
#   make CC=clang-18 headless   same with clang -> build/headless-clang-18 (catches errors emcc will hit)
#   make wasm            WebAssembly with emcc    -> build/wasm/xppaut.mjs + .wasm
#                        (Asyncify) and build/wasm-jspi/ (JSPI, faster, newer
#                        browsers; the page picks one)
#
# Run from the repository root as `make -C web <target>`.

ROOT    := $(abspath ..)
XPP     := $(ROOT)/xppaut
OBJECTS := $(shell cat $(CURDIR)/objects.txt)
XLIB    := xlib.o draw.o fonts_data.o colors_data.o

# Same feature set as the upstream Makefile, minus HAVEDLL (no dlopen in the
# browser).
DEFINES := -DNOERRNO -DNON_UNIX_STDIO -DAUTO -DCVODE_YES \
           -DMYSTR1=8.0 -DMYSTR2=1
INCLUDES := -I$(CURDIR)/include

CFLAGS  ?= -O2
# 30-year-old C: silence warnings from upstream code, keep the build quiet.
XPP_CFLAGS := -MMD -MP -std=gnu99 -D_XOPEN_SOURCE=600 -fcommon -w $(DEFINES) $(INCLUDES)
OWN_CFLAGS := -MMD -MP -std=gnu99 -Wall -Wextra $(INCLUDES)

.PHONY: headless wasm clean

# ---- native, headless -------------------------------------------------------
HL := $(ROOT)/build/headless-$(notdir $(CC))
headless: $(HL)/xppaut

$(HL)/xppaut: $(addprefix $(HL)/,$(OBJECTS) $(XLIB) platform_native.o)
	$(CC) -fcommon -o $@ $^ -lm

$(HL)/%.o: $(XPP)/%.c | $(HL)
	$(CC) $(CFLAGS) $(XPP_CFLAGS) -c $< -o $@

$(HL)/%.o: xlib/%.c | $(HL)
	$(CC) $(CFLAGS) $(OWN_CFLAGS) -c $< -o $@

# ---- WebAssembly ------------------------------------------------------------
WA := $(ROOT)/build/wasm
EMCC ?= emcc
# called by the page (src/xpp.ts)
XW_EXPORTS := _xw_render,_xw_toplevels,_xw_toplevel_dirty,_xw_title,_xw_toplevel_info,_xw_input_motion,_xw_input_button,_xw_input_key,_xw_input_configure,_xw_input_close,_xw_input_raise
# touch controls (xlib/xpp_hooks.c)
XW_EXPORTS := $(XW_EXPORTS),_xw_graph_xy,_xw_params,_xw_slider_setup,_xw_slider_where,_xw_slider_info,_xw_write_csv,_xw_set_value,_xw_export_session
# XPP's event loops block in XNextEvent; the browser needs them to yield.
# Asyncify instruments the code (works everywhere, ~1.5-2x slower); JSPI
# lets the engine suspend wasm (native speed, needs WebAssembly.Suspending).
WASM_LDFLAGS := -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createXpp \
                -sENVIRONMENT=web,node -sALLOW_MEMORY_GROWTH=1 \
                -sINVOKE_RUN=0 -sEXIT_RUNTIME=1 -sFORCE_FILESYSTEM=1 \
                -sEXPORTED_RUNTIME_METHODS=callMain,FS,NODEFS,ENV,HEAPU8,HEAP32,UTF8ToString,stringToUTF8 \
                -sEXPORTED_FUNCTIONS=_main,_malloc,_free,$(XW_EXPORTS) \
                -sSTACK_SIZE=4MB -lnodefs.js \
                -Wl,--wrap=fopen -Wl,--wrap=fclose
# fopen/fclose are wrapped (platform_web.c) so the page learns about every
# file XPP writes and can download it
WJ := $(ROOT)/build/wasm-jspi
WASM_OBJS = $(addprefix $(WA)/,$(OBJECTS) $(XLIB) platform_web.o xpp_hooks.o)

wasm: $(WA)/xppaut.mjs $(WJ)/xppaut.mjs

$(WA)/xppaut.mjs: $(WASM_OBJS)
	$(EMCC) -O2 -o $@ $^ $(WASM_LDFLAGS) -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=1MB

$(WJ)/xppaut.mjs: $(WASM_OBJS) | $(WJ)
	$(EMCC) -O2 -o $@ $^ $(WASM_LDFLAGS) -sJSPI=1

$(WA)/%.o: $(XPP)/%.c | $(WA)
	$(EMCC) -O2 $(XPP_CFLAGS) -c $< -o $@

# reads XPP's globals, so it needs XPP's headers
$(WA)/xpp_hooks.o: xlib/xpp_hooks.c | $(WA)
	$(EMCC) -O2 $(OWN_CFLAGS) -I$(XPP) -Wno-unused-parameter -c $< -o $@

$(WA)/%.o: xlib/%.c | $(WA)
	$(EMCC) -O2 $(OWN_CFLAGS) -c $< -o $@

$(HL) $(WA) $(WJ):
	mkdir -p $@

# Header dependencies generated by -MMD
-include $(wildcard $(HL)/*.d $(WA)/*.d)

clean:
	rm -rf $(HL) $(WA) $(WJ)
