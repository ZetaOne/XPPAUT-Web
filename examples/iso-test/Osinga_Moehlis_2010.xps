# Osinga_Moehlis_2010.xps -- the figures of Osinga & Moehlis (2010) with XPPAUT 8.4 scripting (see Osinga_Moehlis_2010.ode).
# File > Do script in XPPAUT 8.4 or XPPAUT-Web.  It pauses after each figure: press Enter.
# Each figure is also saved as osinga_figN.svg (osinga_figNa.svg ... for the panels).
speed 0.05

# ======================================================================================
# Figure 1: the periodic orbit Gamma of the reduced Hodgkin-Huxley model
# ======================================================================================
keys g f r
try
  keys m k
  ans y
end
keys g f r
set lt=1
keys u c n
keys esc
msg "Figure 1: the periodic orbit Gamma of the reduced Hodgkin-Huxley model"
keys v 2
ans X-axis=v|Y-axis=w|Xmin=-90|Ymin=0.3|Xmax=52|Ymax=0.8|Xlabel=V|Ylabel=n
set k=1;total=1;v=44.706379;w=0.45973791;dl=0;w0=0.45973791
keys i g
keys n n
keys g f f
ans Color=0|Key=Gamma|Name=Gamma
shot osinga_fig1b.svg
keys m c
keys v 2
ans X-axis=tt|Y-axis=v|Xmin=0|Ymin=-90|Xmax=5|Ymax=50|Xlabel=t/T|Ylabel=V
set k=5;total=1;v=44.706379;w=0.45973791;dl=0;w0=0.45973791
keys i g
shot osinga_fig1.svg
pause "Figure 1 done: Enter for the next figure"

# ======================================================================================
# Figure 2: 20 isochrons, phases 0, 0.05, ..., 0.95 (stage 1: one-period segments)
# ======================================================================================
keys g f r
try
  keys m k
  ans y
end
keys g f r
set lt=1
keys u c n
keys esc
msg "Figure 2: 20 isochrons, phases 0, 0.05, ..., 0.95 (stage 1: one-period segments)"
keys f a
try
  autokeys f r
  ans y
end
msg "Figure 2: the isochron of phase 0.00, one way (1 of 40)"
set k=1;gv0=44.706379;gw0=0.45973791;ev=0.9999999906;ew=-0.0001371081336
set p=44.706379;total=1;v=44.706379;w=0.45973791;dl=0;w0=0.45973791
keys i g
autokeys n
ans Ntst=100|Nmax=42|NPr=100000|Ds=0.01|Dsmin=1e-08|Dsmax=0.3|Par Min=-100|Par Max=55|Norm Max=1e6|ITNW=20
autokeys r b
