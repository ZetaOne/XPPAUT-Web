# M3_ML.xps -- method M3 (boundary value continuation) for M3_ML.ode,
# in XPP's own AUTO.  File > Do script in XPPAUT 8.4 (or XPPAUT-Web).  Each step is explained in the .ode.
speed 0.1
msg "Step 1: the starting solution, Γ from gamma0 for k = 3 periods (time rescaled to 0..1)"
keys i g
keys f a
msg "Step 3: AUTO numerics (Ntst 300, Ds -0.01, p = v(0) from -80 to 60)"
autokeys n
ans Ntst=300|Nmax=185|NPr=100000|Ds=-0.01|Dsmin=1e-08|Dsmax=0.5|Par Min=-80|Par Max=60|Norm Max=1e6|ITNW=8
msg "Step 4: Run > Bdry Value -- the isochron to the left of gamma0"
autokeys r b
msg "Step 5: back to the start, the other way -- the isochron to the right"
set p=33.32581;v=33.32581;w=0.3054107;dl=0;w0=0.3054107
keys i g
autokeys n
ans Nmax=60|Ds=0.01
autokeys r b
msg "Step 6: one point's orbit segment, in the main window"
auto goto LP 1
keys i g
msg "Done. The AUTO window is the isochron of phase 0, w(0) against v(0). M3 works where M2 cannot: no backward integration. Its limitation (the end point must stay on the straight piece of the isochron): M3_limitation_linear_ML.ode"
